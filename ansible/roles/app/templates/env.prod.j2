# ============================================
# TeleDoc — Production Environment Variables
# ============================================
# Rendered by Ansible template engine (Jinja2)
# ============================================

# ECR Registry
ECR_REGISTRY={{ ecr_registry }}
IMAGE_TAG={{ image_tag | default('latest') }}

# App
APP_URL={{ app_url | default('http://localhost') }}
APP_KEY={{ app_key }}

# Database (RDS)
DB_HOST={{ db_host }}
DB_DATABASE={{ db_name }}
DB_USERNAME={{ db_username }}
DB_PASSWORD={{ db_password }}
